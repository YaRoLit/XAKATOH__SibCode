# В контейнере хост БД — алиас `db` из Infra.
# Локально без Docker: postgresql+asyncpg://admin:secret@127.0.0.1:5432/dronemon
DB_DSN=postgresql+asyncpg://admin:secret@db:5432/dronemon
JWT_SECRET=change-me-hackathon-secret
JWT_EXPIRE_HOURS=12
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_API_PORT=8001
